# Copy this file to .env and replace each "paste-..." value with your own.
# Anything still starting with "paste-" is treated as not set. With no keys at
# all, Forward-It still runs with the local simulator and the offline parser.

PORT=3000
TIMEZONE=Asia/Kolkata

# ---------- AI: Groq ----------
# Create a key at https://console.groq.com/keys (it starts with gsk_)
GROQ_API_KEY=paste-your-groq-api-key-here
# Model for text messages and PDFs
GROQ_MODEL=openai/gpt-oss-120b
# Model for photos and screenshots (must accept images)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ---------- AI: Claude (optional alternative to Groq) ----------
# If both keys are set, Groq is used unless you set AI_PROVIDER=claude.
# ANTHROPIC_API_KEY=paste-your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=groq

# ---------- WhatsApp: Twilio Sandbox ----------
# Twilio Console -> Account Info. The SID starts with AC.
TWILIO_ACCOUNT_SID=paste-your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=paste-your-twilio-auth-token-here
# The sandbox's WhatsApp number. Keep the "whatsapp:" prefix.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# How often to check Twilio for new messages (seconds). No public URL needed.
TWILIO_POLL_SECONDS=3
# Your sandbox's join phrase (Twilio sandbox page), shown on the website with a
# QR code so visitors can try the bot, e.g. join happy-tiger
TWILIO_SANDBOX_CODE=paste-your-sandbox-join-code-here

# Optional: webhook mode instead of polling. Only needed if you run a tunnel
# (cloudflared / ngrok). Setting PUBLIC_URL switches to webhook mode; you can
# also force a mode with WHATSAPP_MODE=poll or WHATSAPP_MODE=webhook.
PUBLIC_URL=paste-your-public-https-url-here
# WHATSAPP_MODE=poll
# Set WHATSAPP_MODE=off on your laptop once the deployed copy is answering
# WhatsApp, so the two don't both reply to the same message.
